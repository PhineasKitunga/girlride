rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default: Deny all access
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Maps configuration - READ ONLY for authenticated users
    // This protects your API keys from unauthorized access
    match /maps/config {
      // Only authenticated users can read the config
      allow read: if request.auth != null;
      
      // Nobody can write or delete (only admin via Firebase Console)
      allow write, delete: if false;
    }
    
    // User profiles
    match /users/{userId} {
      // Users can only read/write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Rides collection
    match /rides/{rideId} {
      // Users can read rides they're part of
      allow read: if request.auth != null && 
                     (resource.data.riderId == request.auth.uid || 
                      resource.data.driverId == request.auth.uid);
      
      // Users can create rides
      allow create: if request.auth != null && 
                       request.resource.data.riderId == request.auth.uid;
      
      // Users can update their own rides
      allow update: if request.auth != null && 
                       (resource.data.riderId == request.auth.uid || 
                        resource.data.driverId == request.auth.uid);
    }
    
    // Trusted contacts
    match /users/{userId}/trusted_contacts/{contactId} {
      // Users can only manage their own trusted contacts
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Emergency alerts
    match /emergency_alerts/{alertId} {
      // Users can read alerts they created or are recipients of
      allow read: if request.auth != null && 
                     (resource.data.userId == request.auth.uid ||
                      request.auth.uid in resource.data.recipients);
      
      // Users can create their own emergency alerts
      allow create: if request.auth != null && 
                       request.resource.data.userId == request.auth.uid;
      
      // Users can update their own emergency alerts
      allow update: if request.auth != null && 
                       resource.data.userId == request.auth.uid;
    }
  }
}
